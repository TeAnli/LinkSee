{
  "name": "linksee",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "concurrently \"pnpm dev:web\" \"pnpm dev:backend-fastapi\"",
    "dev:web": "pnpm --filter @linksee/web dev",
    "dev:backend-fastapi": "cd backend-fastapi && bash scripts/start.sh",
    "dev:ws": "cd ws-server && gradlew.bat bootRun",
    "build": "pnpm --filter ./packages/** build && pnpm --filter ./apps/** build",
    "build:web": "pnpm --filter ./apps/** build",
    "build:backend-fastapi": "cd backend-fastapi && pnpm build",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "test": "pnpm -r test",
    "test:backend-fastapi": "cd backend-fastapi && pnpm test",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "clean": "pnpm -r clean"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}