{
  "name": "linksee",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "concurrently \"pnpm dev:web\" \"pnpm dev:server\"",
    "dev:web": "pnpm --filter @linksee/web dev",
    "dev:server": "cd apps/server && node -e \"var e=require('child_process').execSync;var c=process.platform==='win32'?'cmd /c scripts\\\\start.bat':'bash scripts/start.sh';e(c,{stdio:'inherit'})\"",
    "dev:ws": "cd apps/ws-server && gradlew.bat bootRun",
    "build": "pnpm --filter ./packages/** build && pnpm --filter ./apps/** build",
    "build:web": "pnpm --filter ./apps/** build",
    "build:server": "cd apps/server && pnpm build",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "test": "pnpm -r test",
    "test:server": "cd apps/server && pnpm test",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "clean": "pnpm -r clean"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}